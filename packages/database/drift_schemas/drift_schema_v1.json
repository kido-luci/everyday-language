  "fixed_sql": [
    {
      "name": "words",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"words\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"lemma\" TEXT NOT NULL UNIQUE, \"display\" TEXT NOT NULL, \"phonetic\" TEXT NULL, \"part_of_speech\" TEXT NULL, \"meaning_en\" TEXT NULL, \"meaning_vi\" TEXT NULL, \"collocation\" TEXT NULL, \"enrichment_status\" TEXT NOT NULL DEFAULT 'pending', \"created_at_us\" INTEGER NOT NULL, \"updated_at_us\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "capture_sources",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"capture_sources\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"kind\" TEXT NOT NULL, \"label\" TEXT NULL, \"uri\" TEXT NULL, \"created_at_us\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "examples",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"examples\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"word_id\" INTEGER NOT NULL, \"sentence\" TEXT NOT NULL, \"translation\" TEXT NULL, \"origin\" TEXT NOT NULL, \"source_id\" INTEGER NULL, \"created_at_us\" INTEGER NOT NULL, FOREIGN KEY (word_id) REFERENCES words(id) ON DELETE CASCADE, FOREIGN KEY (source_id) REFERENCES capture_sources(id) ON DELETE SET NULL);"
        }
      ]
    },
    {
      "name": "decks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"decks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"is_seed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_seed\" IN (0, 1)), \"created_at_us\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "deck_words",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"deck_words\" (\"deck_id\" INTEGER NOT NULL, \"word_id\" INTEGER NOT NULL, PRIMARY KEY (\"deck_id\", \"word_id\"), FOREIGN KEY (deck_id) REFERENCES decks(id) ON DELETE CASCADE, FOREIGN KEY (word_id) REFERENCES words(id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "cards",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cards\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"word_id\" INTEGER NOT NULL, \"kind\" TEXT NOT NULL, \"phase\" TEXT NOT NULL DEFAULT 'learning', \"step\" INTEGER NULL, \"stability\" REAL NULL, \"difficulty\" REAL NULL, \"due_at_us\" INTEGER NOT NULL, \"last_reviewed_at_us\" INTEGER NULL, \"reps\" INTEGER NOT NULL DEFAULT 0, \"lapses\" INTEGER NOT NULL DEFAULT 0, UNIQUE (\"word_id\", \"kind\"), FOREIGN KEY (word_id) REFERENCES words(id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "review_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"card_id\" INTEGER NOT NULL, \"grade\" TEXT NOT NULL, \"previous_phase\" TEXT NOT NULL, \"elapsed_ms\" INTEGER NULL, \"reviewed_at_us\" INTEGER NOT NULL, FOREIGN KEY (card_id) REFERENCES cards(id) ON DELETE CASCADE);"
        }
      ]
    }
  ]
}